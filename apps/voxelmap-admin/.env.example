# copy to .env.local and fill in real values for local dev
# (Vite/Astro loads .env.local automatically — never commit it)

# used for both the better-auth store and the "pois" collection
MONGODB_URI=
BETTER_AUTH_URL=http://localhost:4321
BETTER_AUTH_SECRET=
# fine-grained PAT, Actions: write only (triggers the deploy workflow)
GITHUB_TOKEN=
GITHUB_REPO=alexandremottet/maxthox-zevent-minez
