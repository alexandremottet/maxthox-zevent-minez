---
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>VoxelMap Viewer</title>
    <link rel="icon" type="image/x-icon" href="/favicon.svg">
    <style is:global>
      html, body { margin: 0; height: 100%; }
      #map { height: 100vh; width: 100vw; background: #052305; }

      .hud-bar {
        position: fixed;
        left: 50%;
        transform: translateX(-50%);
        background: #000;
        border: 2px solid #fff;
        font-family: "Minecraft", monospace;
        z-index: 1000;
      }

      .hud-title {
        top: 12px;
        padding: 6px 16px;
        font-size: 20px;
        white-space: nowrap;
      }

      .hud-toolbar {
        bottom: 12px;
        display: flex;
        gap: 6px;
        padding: 6px;
      }

      .hud-button {
        background: #000;
        border: 1px solid #fff;
        color: #fff;
        font-family: "Minecraft", monospace;
        font-size: 16px;
        line-height: 1;
        padding: 6px 12px;
        cursor: pointer;
      }

      .hud-button:hover:not(:disabled) { background: #333; }
      .hud-button:disabled { opacity: 0.4; cursor: default; }
      .hud-button.active { background: #333; }

      .hud-panel {
        position: fixed;
        top: 60px;
        background: #000;
        border: 2px solid #fff;
        font-family: "Minecraft", monospace;
        color: #fff;
        z-index: 1000;
        max-height: 60vh;
        overflow-y: auto;
        font-size: 13px;
      }

      .hud-panel[hidden] { display: none; }

      .hud-list { right: 12px; min-width: 180px; }
      .hud-colors { left: 12px; min-width: 160px; }

      .hud-panel-title {
        padding: 6px 10px;
        border-bottom: 1px solid #fff;
      }

      .poi-list-items, .color-filter-items {
        list-style: none;
        margin: 0;
        padding: 0;
      }

      .poi-list-item {
        padding: 6px 10px;
        cursor: pointer;
        border-bottom: 1px solid #333;
      }

      .poi-list-item:hover { background: #222; }

      .color-filter-item {
        display: flex;
        align-items: center;
        gap: 8px;
        padding: 6px 10px;
        cursor: pointer;
        border-bottom: 1px solid #333;
      }

      .color-filter-item:hover { background: #222; }

      .color-swatch {
        width: 12px;
        height: 12px;
        border: 1px solid #fff;
        flex-shrink: 0;
      }

      /* blocky (pixel-art) circle, radius 16px, traced as a stepped clip-path — the outer ring is the POI color */
      .poi-marker-icon {
        background: var(--poi-color, #f00);
        position: relative;
        clip-path: polygon(
          12px 0px, 12px 1px, 9px 1px, 9px 2px, 7px 2px, 7px 3px, 6px 3px, 6px 4px, 5px 4px, 5px 5px, 4px 5px, 4px 6px, 3px 6px, 3px 7px, 2px 7px, 2px 8px, 2px 9px, 1px 9px, 1px 10px, 1px 11px, 1px 12px, 0px 12px, 0px 13px, 0px 14px, 0px 15px, 0px 16px, 0px 17px, 0px 18px, 0px 19px, 0px 20px,
          1px 20px, 1px 21px, 1px 22px, 1px 23px, 2px 23px, 2px 24px, 2px 25px, 3px 25px, 3px 26px, 4px 26px, 4px 27px, 5px 27px, 5px 28px, 6px 28px, 6px 29px, 7px 29px, 7px 30px, 9px 30px, 9px 31px, 12px 31px, 12px 32px, 20px 32px, 20px 31px, 23px 31px, 23px 30px, 25px 30px, 25px 29px, 26px 29px, 26px 28px, 27px 28px, 27px 27px, 28px 27px, 28px 26px, 29px 26px, 29px 25px, 30px 25px, 30px 24px, 30px 23px, 31px 23px, 31px 22px, 31px 21px, 31px 20px, 32px 20px, 32px 19px, 32px 18px, 32px 17px, 32px 16px, 32px 15px, 32px 14px, 32px 13px, 32px 12px, 31px 12px, 31px 11px, 31px 10px, 31px 9px, 30px 9px, 30px 8px, 30px 7px, 29px 7px, 29px 6px, 28px 6px, 28px 5px, 27px 5px, 27px 4px, 26px 4px, 26px 3px, 25px 3px, 25px 2px, 23px 2px, 23px 1px, 20px 1px, 20px 0px
        );
      }

      /* white pixel-circle inset over the colored outer shape, leaving a colored ring border */
      .poi-marker-icon::before {
        content: "";
        position: absolute;
        inset: 0;
        background: rgba(255, 255, 255, 0.5);
        clip-path: polygon(
          13px 4px, 13px 5px, 10px 5px, 10px 6px, 9px 6px, 9px 7px, 8px 7px, 8px 8px, 7px 8px, 7px 9px, 6px 9px, 6px 10px, 5px 10px, 5px 11px, 5px 12px, 4px 12px, 4px 13px, 4px 14px, 4px 15px, 4px 16px, 4px 17px, 4px 18px, 4px 19px, 5px 19px, 5px 20px, 5px 21px, 5px 22px, 6px 22px, 6px 23px, 7px 23px, 7px 24px, 8px 24px, 8px 25px, 9px 25px, 9px 26px, 10px 26px, 10px 27px, 13px 27px, 13px 28px, 19px 28px, 19px 27px, 22px 27px, 22px 26px, 23px 26px, 23px 25px, 24px 25px, 24px 24px, 25px 24px, 25px 23px, 26px 23px, 26px 22px, 27px 22px, 27px 21px, 27px 20px, 27px 19px, 28px 19px, 28px 18px, 28px 17px, 28px 16px, 28px 15px, 28px 14px, 28px 13px, 27px 13px, 27px 12px, 27px 11px, 27px 10px, 26px 10px, 26px 9px, 25px 9px, 25px 8px, 24px 8px, 24px 7px, 23px 7px, 23px 6px, 22px 6px, 22px 5px, 19px 5px, 19px 4px
        );
      }

      /* clip-path on the parent also clips this pseudo-element to the outer round shape */
      .poi-marker-icon::after {
        content: "";
        position: absolute;
        top: -50%;
        left: -50%;
        width: 200%;
        height: 200%;
        background: linear-gradient(135deg, transparent 40%, rgba(255, 255, 255, 0.9) 50%, transparent 60%);
        animation: poi-shine 2s linear infinite;
      }

      @keyframes poi-shine {
        from { transform: translate(-100%, -100%); }
        to { transform: translate(100%, 100%); }
      }

      .leaflet-popup-tip-container { display: none; }

      .leaflet-popup-content-wrapper {
        background: #000;
        border: 2px solid #fff;
        border-radius: 0;
        box-shadow: none;
      }

      .leaflet-popup-content {
        margin: 8px 10px;
        font-family: "Minecraft", monospace;
        font-size: 14px;
      }

      .poi-popup-desc { margin-top: 4px; }

      .leaflet-popup-close-button {
        color: #fff !important;
        font-family: "Minecraft", monospace;
      }
    </style>
  </head>
  <body>
    <div id="map"></div>

    <div class="hud-bar hud-title">
      <span class="minecraft-green">MATHOX1MINEZ</span>
      <span class="minecraft-white">&nbsp;/&nbsp;</span>
      <span class="minecraft-green">ZEVENT 2026</span>
    </div>

    <div class="hud-bar hud-toolbar">
      <button id="zoom-out" class="hud-button" aria-label="Zoom out">-</button>
      <button id="zoom-fit" class="hud-button" aria-label="Fit whole map">Fit</button>
      <button id="zoom-in" class="hud-button" aria-label="Zoom in">+</button>
      <button id="toggle-list" class="hud-button active" aria-label="Toggle POI list">List</button>
      <button id="toggle-colors" class="hud-button" aria-label="Toggle color filters">Colors</button>
    </div>

    <div id="poi-list" class="hud-panel hud-list">
      <div class="hud-panel-title minecraft-white">POI</div>
      <ul id="poi-list-items" class="poi-list-items"></ul>
    </div>

    <div id="colors-panel" class="hud-panel hud-colors" hidden>
      <div class="hud-panel-title minecraft-white">Colors</div>
      <ul id="color-filter-items" class="color-filter-items"></ul>
    </div>

    <script src="../scripts/map.ts"></script>
  </body>
</html>
