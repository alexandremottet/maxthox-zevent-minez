---
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>VoxelMap Viewer</title>
    <link rel="icon" type="image/x-icon" href="/favicon.svg">
    <style is:global>
      html, body { margin: 0; height: 100%; }
      #map { height: 100vh; width: 100vw; background: #052305; }

      .hud-bar {
        position: fixed;
        left: 50%;
        transform: translateX(-50%);
        background: #000;
        border: 2px solid #fff;
        font-family: "Minecraft", monospace;
        z-index: 1000;
      }

      .hud-title {
        top: 12px;
        padding: 6px 16px;
        font-size: 20px;
        white-space: nowrap;
      }

      .hud-toolbar {
        bottom: 12px;
        display: flex;
        gap: 6px;
        padding: 6px;
      }

      .hud-button {
        background: #000;
        border: 1px solid #fff;
        color: #fff;
        font-family: "Minecraft", monospace;
        font-size: 16px;
        line-height: 1;
        padding: 6px 12px;
        cursor: pointer;
      }

      .hud-button:hover:not(:disabled) { background: #333; }
      .hud-button:disabled { opacity: 0.4; cursor: default; }
      .hud-button.active { background: #333; }

      .hud-panel {
        position: fixed;
        top: 60px;
        background: #000;
        border: 2px solid #fff;
        font-family: "Minecraft", monospace;
        color: #fff;
        z-index: 1000;
        max-height: 60vh;
        overflow-y: auto;
        font-size: 13px;
      }

      .hud-panel[hidden] { display: none; }

      .hud-list { right: 12px; min-width: 180px; }
      .hud-colors { left: 12px; min-width: 160px; }

      .hud-panel-title {
        padding: 6px 10px;
        border-bottom: 1px solid #fff;
      }

      .poi-list-items, .color-filter-items {
        list-style: none;
        margin: 0;
        padding: 0;
      }

      .poi-list-item {
        padding: 6px 10px;
        cursor: pointer;
        border-bottom: 1px solid #333;
      }

      .poi-list-item:hover { background: #222; }

      .color-filter-item {
        display: flex;
        align-items: center;
        gap: 8px;
        padding: 6px 10px;
        cursor: pointer;
        border-bottom: 1px solid #333;
      }

      .color-filter-item:hover { background: #222; }

      .color-swatch {
        width: 12px;
        height: 12px;
        border: 1px solid #fff;
        flex-shrink: 0;
      }

      .poi-marker-icon {
        background: #000;
        border: 2px solid #f00;
        border-radius: 0;
        position: relative;
        overflow: hidden;
      }

      .poi-marker-icon::after {
        content: "";
        position: absolute;
        top: -50%;
        left: -50%;
        width: 200%;
        height: 200%;
        background: linear-gradient(135deg, transparent 40%, rgba(85, 255, 85, 0.9) 50%, transparent 60%);
        animation: poi-shine 2s linear infinite;
      }

      @keyframes poi-shine {
        from { transform: translate(-100%, -100%); }
        to { transform: translate(100%, 100%); }
      }

      .leaflet-popup-tip-container { display: none; }

      .leaflet-popup-content-wrapper {
        background: #000;
        border: 2px solid #fff;
        border-radius: 0;
        box-shadow: none;
      }

      .leaflet-popup-content {
        margin: 8px 10px;
        font-family: "Minecraft", monospace;
        font-size: 14px;
      }

      .poi-popup-desc { margin-top: 4px; }

      .leaflet-popup-close-button {
        color: #fff !important;
        font-family: "Minecraft", monospace;
      }
    </style>
  </head>
  <body>
    <div id="map"></div>

    <div class="hud-bar hud-title">
      <span class="minecraft-green">MATHOX1MINEZ</span>
      <span class="minecraft-white">&nbsp;/&nbsp;</span>
      <span class="minecraft-green">ZEVENT 2026</span>
    </div>

    <div class="hud-bar hud-toolbar">
      <button id="zoom-out" class="hud-button" aria-label="Zoom out">-</button>
      <button id="zoom-fit" class="hud-button" aria-label="Fit whole map">Fit</button>
      <button id="zoom-in" class="hud-button" aria-label="Zoom in">+</button>
      <button id="toggle-list" class="hud-button active" aria-label="Toggle POI list">List</button>
      <button id="toggle-colors" class="hud-button" aria-label="Toggle color filters">Colors</button>
    </div>

    <div id="poi-list" class="hud-panel hud-list">
      <div class="hud-panel-title minecraft-white">POI</div>
      <ul id="poi-list-items" class="poi-list-items"></ul>
    </div>

    <div id="colors-panel" class="hud-panel hud-colors" hidden>
      <div class="hud-panel-title minecraft-white">Colors</div>
      <ul id="color-filter-items" class="color-filter-items"></ul>
    </div>

    <script src="../scripts/map.ts"></script>
  </body>
</html>
