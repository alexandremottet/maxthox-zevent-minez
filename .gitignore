.tokensave
.gitkeep
.DS_Store
**/*/.DS_Store
.astro
.vercel

node_modules
dist
packages/.DS_Store

.env
.env.local
.env.*.local
!.env.example
.env*

# local BlueMap render workspace: CLI jar + Mojang client download + render
# cache — regenerable (CI downloads the jar and re-renders), and the Mojang
# jar must not be redistributed. config/ is real hand-tuned settings (ambient
# light, flat-view default, cave-hiding disabled, marker-set wiring), not
# generated — kept committed.
packages/voxelmap-to-image/bluemap-cli/*
!packages/voxelmap-to-image/bluemap-cli/config/

# rendered BlueMap output copied into each app's public dir — regenerated by
# CI (pnpm --filter voxelmap-to-image run bluemap) before each build
apps/*/public/bluemap/

# scratch copy of the world save with far region files pruned out, made by
# prune-world-save.mjs when BLUEMAP_PRUNE_RADIUS is set — regenerable
packages/voxelmap-to-image/.bluemap-pruned-save/

# same idea for the VoxelMap cache, made by prune-voxelmap-cache.mjs when
# VOXELMAP_PRUNE_RADIUS is set — regenerable
packages/voxelmap-to-image/.voxelmap-pruned-cache/
